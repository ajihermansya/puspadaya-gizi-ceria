# .env sengaja ikut dilacak — isinya semua berprefix VITE_ yang memang
# ditanamkan ke bundle browser, jadi bukan rahasia. Lihat .env.example.
#
# Varian lokal (.env.local, .env.production) tetap diabaikan supaya override
# di mesin masing-masing tidak ikut ter-push.
.env.*
!.env.example

