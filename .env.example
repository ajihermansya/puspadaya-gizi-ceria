# Salin ke .env lalu isi nilainya. Jangan commit .env.
#
# Catatan penting soal prefix VITE_:
# Vite menanamkan setiap variabel berawalan VITE_ ke dalam bundle JavaScript
# yang dikirim ke browser. Variabel di bawah ini TIDAK rahasia — siapa pun
# yang membuka situs bisa membacanya dari devtools. Jangan pernah menaruh
# kredensial asli (private key, password database, token admin) dengan prefix
# VITE_; yang seperti itu hanya boleh hidup di server.

# EmailJS — ketiga ID ini memang dirancang untuk dipakai dari browser.
# Pengamanannya bukan kerahasiaan, tapi pengaturan di dasbor EmailJS:
# batasi domain yang diizinkan dan pasang rate limit.
VITE_EMAILJS_USER_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Base URL backend. Di dev, proxy diatur di vite.config.ts;
# di produksi, lewat public/_redirects.
VITE_API_BASE_URL=
